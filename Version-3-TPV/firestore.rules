rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() { return role() == 'admin'; }
    function isWaiter() { return role() == 'waiter'; }
    function isKitchen() { return role() == 'kitchen'; }
    function isStaff() { return isAdmin() || isWaiter() || isKitchen(); }
    function isOrderOwner() {
      return request.resource.data.clientTokenId == resource.data.clientTokenId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (request.auth.uid == userId && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['email', 'name', 'updatedAt']));
    }

    match /tables/{tableId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isWaiter() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['active', 'currentSessionId', 'paymentRequested', 'paymentMethod',
            'paymentSplitCount', 'paymentNote', 'updatedAt'])) ||
        (!signedIn() && request.resource.data.active == true &&
          request.resource.data.currentSessionId is string &&
          request.resource.data.qrIdentifier == resource.data.qrIdentifier &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'currentSessionId', 'updatedAt']));
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /tableSessions/{sessionId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.clientTokenId is string &&
        request.resource.data.tableId is string &&
        request.resource.data.sessionId is string &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.status == 'PENDING';
      allow update: if isAdmin() || isWaiter() ||
        (isKitchen() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'startedAt', 'readyAt', 'items', 'total', 'updatedAt'])) ||
        (isOrderOwner() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentRequested', 'paymentMethod', 'paymentSplitCount',
            'paymentNote', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read, create, update: if isAdmin() || isWaiter();
      allow delete: if isAdmin();
    }

    match /cashRegisters/{registerId} {
      allow read, write: if isAdmin();
    }

    match /cashClosures/{closureId} {
      allow read, write: if isAdmin();
    }

    match /cashMovements/{movementId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
